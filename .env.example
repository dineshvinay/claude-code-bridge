# hubos-bridge configuration. Copy to .env.local (auto-created on first run).
# The token is generated for you on first `npm start`; you normally don't set it by hand.

# HUBOS_BRIDGE_TOKEN=<auto-generated>
# HUBOS_BRIDGE_PORT=7420
# HUBOS_WORKSPACE_ROOT=E:\GitHub
# HUBOS_ALLOWED_ORIGINS=https://hub.prodmtech.in,http://localhost:3000,http://127.0.0.1:3000
# HUBOS_SHELL=powershell.exe
